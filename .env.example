# Server port
PORT=3090

# Shared secret for authenticating API requests (Bearer token or X-Scraper-Secret header).
# Leave empty ONLY for local development without auth.
SCRAPER_API_SECRET=change-me-to-a-long-random-secret

# Max concurrent crawl/scrape jobs running in parallel (keep 1-2 for 1-2GB RAM containers)
MAX_CONCURRENCY=2

# Per-page Playwright navigation timeout in ms
PAGE_TIMEOUT_MS=15000

# How long finished jobs stay in memory for polling (in minutes)
JOB_TTL_MINUTES=60
